def apply_ansatz(state, Hc, Hm, para_list):
    # print("State norm:", np.linalg.norm(state))
    depth = len(para_list)//2
    for d in range(depth):
        state = expm(-1j*para_list[d]*Hm) @ expm(-1j*para_list[depth+d]*Hc) @ state
    # print("State norm:", np.linalg.norm(state))
    return state

def EV(state, Hc):
    state2 = Hc @ state
    ev = np.vdot(state, state2)
    return ev
 
def Exact(Hc_full):
    eigenvalues, eigenvectors = np.linalg.eigh(Hc_full)
    # degenerate_indices = np.where(energies == min_energy)[0] # DANGEROUS: Do not do this; miss degeneracy due to floating point error
    degenerate_indices = np.where(np.isclose(eigenvalues, eigenvalues[0], atol=1e-12))[0]
    # print(f"Ground state energy: {eigenvalues[0]}")
    # print(f"Degeneracy level: {len(degenerate_indices)}")
    # Extract all degenerate eigenvectors)
    for idx in degenerate_indices:
        Hc_full[idx] = eigenvectors[:, idx]
        # print(f"Statevector {idx}: {Hc[idx]}")
    return [Hc_full[idx] for idx in degenerate_indices], eigenvalues[0]

def objective(coeff_list, state, Hc, Hm, depth):
    global cost_function_access, layers_evaluated
    cost_function_access+=1
    layers_evaluated+=depth
    
    c_count = len(coeff_list)//2
    para_list = coeff_to_angles(coeff_list[:c_count], coeff_list[c_count:], depth)
    state = apply_ansatz(state, Hc, Hm, para_list)
    ev = EV(state, Hc)
    return np.real(ev)

# Array version
def coeff_to_angles(coeff_list_gamma, coeff_list_beta, depth):        
    gammas = np.array([])
    betas = np.array([])        
    for d in range(depth):
        x = (d+1)/depth
        if depth <=1:
            gammas = np.append(gammas, [0])
            betas = np.append(betas, [1])
        else:
            gammas = np.append(gammas, [Chebyshev_poly(x, coeff_list_gamma)])
            betas = np.append(betas, [Chebyshev_poly(x, coeff_list_beta)])
    para_list = np.concatenate((gammas, betas))
    return para_list
    
# Array version
def Chebyshev_poly(x, coeff_list):
    Poly_value = 0
    for j in range(len(coeff_list)):
        Poly_value += ( coeff_list[j]*math.cos(j*math.acos(2*x-1)) )
    return Poly_value
    
