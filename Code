def rna_conflict_graph():
    global Hc_full, Hc, Hm, num_qubits
    
    # Toy RNA Sequence: 'C A G U G C' (Nucleotide indices 0 to 5)
    # We define our 5 Qubits as the 5 possible valid base pairs:
    # Qubit 0: C0 pairs with G2
    # Qubit 1: C0 pairs with G4
    # Qubit 2: A1 pairs with U3
    # Qubit 3: G2 pairs with C5
    # Qubit 4: U3 pairs with G4 (Wobble pair)
    num_qubits = 5
    
    # Edges represent structural conflicts. 
    # For example, Qubit 0 and Qubit 1 both require nucleotide C0. They cannot both exist!
    edges = [
        (0, 1),  # Conflict at C0
        (0, 3),  # Conflict at G2
        (1, 4),  # Conflict at G4
        (2, 4)   # Conflict at U3
    ]
    
    G = nx.Graph()
    G.add_nodes_from(range(num_qubits))
    G.add_edges_from(edges)


# Graph representation

    # Visualization
    nx.draw(G, with_labels=True, node_color='lightblue', node_size=800, font_weight='bold')
    plt.title("RNA Base-Pair Conflict Graph")
    plt.show()

    # --- 2. Build Cost Hamiltonian (Hc) ---
    Hc = QubitOperator()
    
    # Reward: Encourage base pairs (-0.5 Z_i)
    for i in range(num_qubits):
        Hc += QubitOperator(f'Z{i}', -0.5)
    
    # Penalty: Discourage structural conflicts (+ P/4 Z_i Z_j - P/4 Z_i - P/4 Z_j)
    penalty = 2.0
    for i, j in edges:
        Hc += QubitOperator(f'Z{i} Z{j}', penalty / 4.0)
        Hc += QubitOperator(f'Z{i}', -penalty / 4.0)
        Hc += QubitOperator(f'Z{j}', -penalty / 4.0)
    
    # Convert to matrix for Interpolated QAOA
    Hc = qubit_operator_sparse(Hc, n_qubits=num_qubits).toarray()
    Hc_full = Hc

    # --- 3. Build Mixer Hamiltonian (Hm) ---
    Hm = QubitOperator()
    
    # Standard Transverse-Field Mixer (Sum of X_i)
    for i in range(num_qubits):
        Hm += QubitOperator(f'X{i}', 1.0)
    Hm = qubit_operator_sparse(Hm, n_qubits=num_qubits).toarray()
    return Hc_full, Hc, Hm, num_qubits, edges, G

