    "def apply_ansatz(state, Hc, Hm, para_list):\n",
    "    # print(\"State norm:\", np.linalg.norm(state))\n",
    "    depth = len(para_list)//2\n",
    "    for d in range(depth):\n",
    "        state = expm(-1j*para_list[d]*Hm) @ expm(-1j*para_list[depth+d]*Hc) @ state\n",
    "    # print(\"State norm:\", np.linalg.norm(state))\n",
    "    return state\n",
    "\n",
    "def EV(state, Hc):\n",
    "    state2 = Hc @ state\n",
    "    ev = np.vdot(state, state2)\n",
    "    return ev\n",
    " \n",
    "def Exact(Hc_full):\n",
    "    eigenvalues, eigenvectors = np.linalg.eigh(Hc_full)\n",
    "    # degenerate_indices = np.where(energies == min_energy)[0] # DANGEROUS: Do not do this; miss degeneracy due to floating point error\n",
    "    degenerate_indices = np.where(np.isclose(eigenvalues, eigenvalues[0], atol=1e-12))[0]\n",
    "    # print(f\"Ground state energy: {eigenvalues[0]}\")\n",
    "    # print(f\"Degeneracy level: {len(degenerate_indices)}\")\n",
    "    # Extract all degenerate eigenvectors)\n",
    "    for idx in degenerate_indices:\n",
    "        Hc_full[idx] = eigenvectors[:, idx]\n",
    "        # print(f\"Statevector {idx}: {Hc[idx]}\")\n",
    "    return [Hc_full[idx] for idx in degenerate_indices], eigenvalues[0]\n",
    "\n",
    "def objective(coeff_list, state, Hc, Hm, depth):\n",
    "    global cost_function_access, layers_evaluated\n",
    "    cost_function_access+=1\n",
    "    layers_evaluated+=depth\n",
    "    \n",
    "    c_count = len(coeff_list)//2\n",
    "    para_list = coeff_to_angles(coeff_list[:c_count], coeff_list[c_count:], depth)\n",
    "    state = apply_ansatz(state, Hc, Hm, para_list)\n",
    "    ev = EV(state, Hc)\n",
    "    return np.real(ev)\n",
    "\n",
    "# Array version\n",
    "def coeff_to_angles(coeff_list_gamma, coeff_list_beta, depth):        \n",
    "    gammas = np.array([])\n",
    "    betas = np.array([])        \n",
    "    for d in range(depth):\n",
    "        x = (d+1)/depth\n",
    "        if depth <=1:\n",
    "            gammas = np.append(gammas, [0])\n",
    "            betas = np.append(betas, [1])\n",
    "        else:\n",
    "            gammas = np.append(gammas, [Chebyshev_poly(x, coeff_list_gamma)])\n",
    "            betas = np.append(betas, [Chebyshev_poly(x, coeff_list_beta)])\n",
    "    para_list = np.concatenate((gammas, betas))\n",
    "    return para_list\n",
    "    \n",
    "# Array version\n",
    "def Chebyshev_poly(x, coeff_list):\n",
    "    Poly_value = 0\n",
    "    for j in range(len(coeff_list)):\n",
    "        Poly_value += ( coeff_list[j]*math.cos(j*math.acos(2*x-1)) )\n",
    "    return Poly_value\n",
    "    \n",
    "def II_QAOA(state, num_qubits, Hc, Hm, depth, dp, target_chemical_error, epsilon, tau_max, coeff_list, maxiter, method, plot=None):\n",
    "    print(\"State shape:\", state.shape)      # Should be (32,)\n",
    "    print(\"Hc matrix shape:\", Hc.shape)     # Should be (32, 32)\n",
    "    print(\"Hm matrix shape:\", Hm.shape)     # Should be (32, 32)\n",
    "    tau=0\n",
    "    delE=math.inf\n",
    "    ev=math.inf\n",
