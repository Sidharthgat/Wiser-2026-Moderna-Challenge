    "def rna_conflict_graph():\n",
    "    global Hc_full, Hc, Hm, num_qubits\n",
    "    \n",
    "    # Toy RNA Sequence: 'C A G U G C' (Nucleotide indices 0 to 5)\n",
    "    # We define our 5 Qubits as the 5 possible valid base pairs:\n",
    "    # Qubit 0: C0 pairs with G2\n",
    "    # Qubit 1: C0 pairs with G4\n",
    "    # Qubit 2: A1 pairs with U3\n",
    "    # Qubit 3: G2 pairs with C5\n",
    "    # Qubit 4: U3 pairs with G4 (Wobble pair)\n",
    "    num_qubits = 5\n",
    "    \n",
    "    # Edges represent structural conflicts. \n",
    "    # For example, Qubit 0 and Qubit 1 both require nucleotide C0. They cannot both exist!\n",
    "    edges = [\n",
    "        (0, 1),  # Conflict at C0\n",
    "        (0, 3),  # Conflict at G2\n",
    "        (1, 4),  # Conflict at G4\n",
    "        (2, 4)   # Conflict at U3\n",
    "    ]\n",
    "    \n",
    "    G = nx.Graph()\n",
    "    G.add_nodes_from(range(num_qubits))\n",
    "    G.add_edges_from(edges)\n",
    "    \n",
    "    # Visualization\n",
    "    nx.draw(G, with_labels=True, node_color='lightblue', node_size=800, font_weight='bold')\n",
    "    plt.title(\"RNA Base-Pair Conflict Graph\")\n",
    "    plt.show()\n",
    "\n",
    "    # --- 2. Build Cost Hamiltonian (Hc) ---\n",
    "    Hc = QubitOperator()\n",
    "    \n",
    "    # Reward: Encourage base pairs (-0.5 Z_i)\n",
    "    for i in range(num_qubits):\n",
    "        Hc += QubitOperator(f'Z{i}', -0.5)\n",
    "    \n",
    "    # Penalty: Discourage structural conflicts (+ P/4 Z_i Z_j - P/4 Z_i - P/4 Z_j)\n",
    "    penalty = 2.0\n",
    "    for i, j in edges:\n",
    "        Hc += QubitOperator(f'Z{i} Z{j}', penalty / 4.0)\n",
    "        Hc += QubitOperator(f'Z{i}', -penalty / 4.0)\n",
    "        Hc += QubitOperator(f'Z{j}', -penalty / 4.0)\n",
    "    \n",
    "    # Convert to matrix for Interpolated QAOA\n",
    "    Hc = qubit_operator_sparse(Hc, n_qubits=num_qubits).toarray()\n",
    "    Hc_full = Hc\n",
    "\n",
    "    # --- 3. Build Mixer Hamiltonian (Hm) ---\n",
    "    Hm = QubitOperator()\n",
    "    \n",
    "    # Standard Transverse-Field Mixer (Sum of X_i)\n",
    "    for i in range(num_qubits):\n",
    "        Hm += QubitOperator(f'X{i}', 1.0)\n",
    "    Hm = qubit_operator_sparse(Hm, n_qubits=num_qubits).toarray()\n",
    "    return Hc_full, Hc, Hm, num_qubits, edges, G\n",
    "\n",
    "# Execute the mapping\n",
    "Hc_full, Hc, Hm, num_qubits, edges, G = rna_conflict_graph()\n",
    "print(\"Number of Qubits:\", num_qubits)\n",
    "print(\"Conflict Edges:\", edges)"
